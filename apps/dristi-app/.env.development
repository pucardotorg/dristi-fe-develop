# Team defaults for `npm run dev`. Committed on purpose: nothing here is a secret, and a
# fresh clone should talk to a local backend with zero setup.
#
# Personal overrides go in `.env.development.local` (git-ignored), which wins over this
# file. Next.js reloads env files while `npm run dev` runs; if a change does not take,
# restart it. Production values are never set here — see `.env.example`.

# The DRISTI backend the /api/v1 proxy forwards to. Origin only, no path.
# Local backend: `make up` in dristi-be serves it on :8000.
API_ORIGIN=http://localhost:8000
