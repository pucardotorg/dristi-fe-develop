# Team defaults for `npm run dev`. Committed on purpose: nothing here is a secret, and a
# fresh clone runs with zero setup: sign-in talks to a local backend, everything else
# uses the in-browser sandbox until its backend is connected. Designers use
# `npm run dev:sandbox` instead, which needs no backend at all.
#
# Personal overrides go in `.env.development.local` (git-ignored), which wins over this
# file; variables set in the shell win over both. Next.js reloads env files while
# `npm run dev` runs; if a change does not take, restart it. Production values are never
# set here — see `.env.example`.

# The DRISTI backend's API root the /api/v1 proxy forwards to (server-only).
# Local backend: `make up` in dristi-be serves it on :8000.
# Shared dev backend instead: API_BASE_URL=https://be.dristi-dev.in/api/v1
API_BASE_URL=http://localhost:8000/api/v1

# Where screens get their data (lib/data/source.ts): `sandbox` = this browser (IndexedDB,
# demo data), `api` = the backend. Sandbox until features are connected; set `api` in
# .env.development.local to see which screens already work against the backend.
NEXT_PUBLIC_DATA_SOURCE=sandbox

# Sign-in and registration go to the backend. `sandbox` = no backend, any 6-digit code.
# When unset, sign-in follows NEXT_PUBLIC_DATA_SOURCE.
NEXT_PUBLIC_AUTH_SOURCE=api
