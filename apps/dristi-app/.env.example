# Every environment variable the Dristi app reads, documented in one place.
#
# How Next.js loads env files (apps/dristi-app/), later rows win:
#   .env                    all modes      git-ignored
#   .env.development        `npm run dev`  committed: team defaults (API_ORIGIN=localhost)
#   .env.production         `build`/`start` not used — deployments set real env vars
#   .env.local              all modes      git-ignored: your machine only
#   .env.development.local  `npm run dev`  git-ignored: your machine only
# Variables already set in the shell or by the host (Docker, Netlify) beat every file.
#
# For local use, copy what you need:
#   cp .env.example .env.development.local

# ---------------------------------------------------------------------------
# Backend (server-only — read at request time, never sent to the browser)
# ---------------------------------------------------------------------------

# The DRISTI backend the /api/v1 proxy forwards to. Origin only: scheme, host, port —
# no path (the proxy adds /api/v1 itself). Unset → /api/v1 answers 503 with a hint.
# Because it is read per request, one build can be pointed at any backend:
#   docker run -e API_ORIGIN=https://be.dristi-dev.in -p 3000:3000 dristi-fe-develop
# The backend must list this app's origin in CSRF_TRUSTED_ORIGINS (e.g.
# http://localhost:3000) or every signed-in write is refused with 403.
# API_ORIGIN=http://localhost:8000

# ---------------------------------------------------------------------------
# FasterFixes feedback widget (docs/feedback-widget.md)
# ---------------------------------------------------------------------------

# Public project ID (proj_...) from https://www.faster-fixes.com → project settings.
# Leave unset to disable the widget entirely: no button, no capture, no network
# calls. Set it only on the deployment reviewers are commenting on.
#
# NEXT_PUBLIC_* is inlined into the client bundle at build time, so this value is
# public by design. It is a per-project write key, not an account credential.
NEXT_PUBLIC_FASTERFIXES_PROJECT_ID=

# Console logs and network requests are attached to each feedback item by
# default. Set to false on any deployment where those payloads must not leave
# our infrastructure.
# NEXT_PUBLIC_FASTERFIXES_CAPTURE_DIAGNOSTICS=false

# Point the widget at a self-hosted FasterFixes instead of their cloud.
# Leave unset to use https://www.faster-fixes.com.
# NEXT_PUBLIC_FASTERFIXES_API_ORIGIN=https://feedback.internal.example
