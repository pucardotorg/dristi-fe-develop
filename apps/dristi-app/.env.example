# Every environment variable the Dristi app reads, documented in one place.
#
# How Next.js loads env files (apps/dristi-app/), later rows win:
#   .env                    all modes      git-ignored
#   .env.development        `npm run dev`  committed: team defaults (local backend, API sign-in)
#   .env.production         `build`/`start` not used — deployments set real env vars
#   .env.local              all modes      git-ignored: your machine only
#   .env.development.local  `npm run dev`  git-ignored: your machine only
# Variables already set in the shell or by the host (Docker, Netlify) beat every file.
#
# For local use, copy what you need:
#   cp .env.example .env.development.local

# ---------------------------------------------------------------------------
# Backend (server-only — read at request time, never sent to the browser)
# ---------------------------------------------------------------------------

# API_BASE_URL — the DRISTI backend's API root, which the app's /api/v1 proxy forwards
# to: /api/v1/users → ${API_BASE_URL}/users/. Include the version path; that is where the
# API version is chosen. Unset → /api/v1 answers 503 with a hint.
# Read per request, so one build (one Docker image) can be pointed at any backend:
#   docker run -e API_BASE_URL=https://be.dristi-dev.in/api/v1 -p 3000:3000 dristi-fe-develop
# The backend must list this app's origin in CSRF_TRUSTED_ORIGINS (e.g.
# http://localhost:3000) or every signed-in write is refused with 403.
# API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# App (NEXT_PUBLIC_* — baked into the browser bundle at BUILD time; never secrets)
# ---------------------------------------------------------------------------

# Where screens get their data (lib/data/source.ts): `api` (default — the backend,
# through each feature's data/http.ts) or `sandbox` (this browser: IndexedDB, fixtures and
# demo seeding; no backend). A screen calling something its feature has not connected yet
# shows "<feature>.<method> is not connected to the backend yet". Unset, it follows a
# sandbox NEXT_PUBLIC_AUTH_SOURCE. `npm run dev:sandbox`, netlify.toml and the published
# Docker image set it to sandbox. Rebuild to change.
# NEXT_PUBLIC_DATA_SOURCE=api

# Who answers sign-in and registration: `api` (the backend, through the proxy) or
# `sandbox` (in the browser, no backend; any 6-digit code works). Unset, it follows
# NEXT_PUBLIC_DATA_SOURCE; set it to pair real sign-in with sandbox data. Rebuild to change.
# NEXT_PUBLIC_AUTH_SOURCE=api

# The app's own public address, for absolute links people share (e.g. a signing link).
# Optional: unset, the address the browser is on is used. Set it when the app is reached
# on one address but shared on another, e.g. https://fe.dristi-dev.in
# NEXT_PUBLIC_APP_BASE_URL=

# ---------------------------------------------------------------------------
# FasterFixes feedback widget (docs/feedback-widget.md)
# ---------------------------------------------------------------------------

# Public project ID (proj_...) from https://www.faster-fixes.com → project settings.
# Leave unset to disable the widget entirely: no button, no capture, no network
# calls. Set it only on the deployment reviewers are commenting on.
#
# NEXT_PUBLIC_* is inlined into the client bundle at build time, so this value is
# public by design. It is a per-project write key, not an account credential.
NEXT_PUBLIC_FASTERFIXES_PROJECT_ID=

# Console logs and network requests are attached to each feedback item by
# default. Set to false on any deployment where those payloads must not leave
# our infrastructure.
# NEXT_PUBLIC_FASTERFIXES_CAPTURE_DIAGNOSTICS=false

# Point the widget at a self-hosted FasterFixes instead of their cloud.
# Leave unset to use https://www.faster-fixes.com.
# NEXT_PUBLIC_FASTERFIXES_API_ORIGIN=https://feedback.internal.example
