{
  "name": "pucar-dristi",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pucar/dristi-app --",
    "build": "npm run build -w @pucar/dristi-app",
    "start": "npm run start -w @pucar/dristi-app",
    "lint": "npm run lint -w @pucar/dristi-app",
    "test:app": "npm test -w @pucar/dristi-app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "lint-staged": "^17.6.1",
    "simple-git-hooks": "^2.14.0"
  }
}
